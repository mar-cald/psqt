abline(hdi(campioni_post, credMass = 0.90))
curve(dbeta(x, 3, 8))
abline(hdi(campioni_post, credMass = 0.90))
abline(xintercept = hdi(campioni_post, credMass = 0.90))
curve(dbeta(x, 3, 8))
vline(hdi(campioni_post, credMass = 0.90))
curve(dbeta(x, 3, 8))
abline(x = hdi(campioni_post, credMass = 0.90))
abline
