#| label: rinforzo-dati
set.seed(8)
controllo <- as.vector(mvrnorm(20, mu = 5.9, Sigma = 1.7^2, empirical = TRUE))
negativo  <- as.vector(mvrnorm(20, mu = 7.0, Sigma = 1.8^2, empirical = TRUE))
positivo  <- as.vector(mvrnorm(20, mu = 9.3, Sigma = 1.8^2, empirical = TRUE))
rinforzo <- data.frame(
condizione = factor(rep(c("controllo", "negativo", "positivo"), each = 20)),
punteggio  = c(controllo, negativo, positivo))
plot(punteggio ~ condizione, data = rinforzo,
xlab = "Condizione", ylab = "Punteggio di ragionamento")
#| label: rinforzo-fit
#| results: hide
fit_rinf0 <- stan_glm(punteggio ~ 1, data = rinforzo, seed = 1)
library(rstanarm)
fit_rinf0 <- stan_glm(punteggio ~ 1, data = rinforzo, seed = 1)
fit_rinf1 <- stan_glm(punteggio ~ condizione, data = rinforzo,
prior_intercept = normal(6, 3),
# prior sullo 0
prior = normal(location = c(0, 0),
scale = c(3, 3)),
seed = 1)
