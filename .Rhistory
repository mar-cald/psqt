a <- 1 + 75; b <- 1 + 240
c(media   = a / (a + b),
mediana = qbeta(0.5, a, b),
map     = (a - 1) / (a + b - 2))
qbeta(c(0.025, 0.975), a, b)                # credible interval 95%
binom.test(75, 315)$conf.int                # confidence interval 95%
1 - pbeta(0.5, a, b)                        # Pr(theta >= 0.5 | D)
pbeta(0.3, a, b)                            # Pr(theta < 0.3 | D)
1 - pbeta(0.5, a, b)                        # Pr(theta >= 0.5 | D)
