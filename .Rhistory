xinf <- rnorm(25, 10, 1.5)
# --- sinistra: dati simulati con un caso influente (lo stesso del pannello sopra) ---
set.seed(20)
xinf <- rnorm(25, 10, 1.5)
yinf <- 2 + xinf + rnorm(25, 0, 1)
xinf <- c(xinf, 18); yinf <- c(yinf, 9)          # outlier influente: X estremo, Y anomalo
m0 <- lm(yinf ~ xinf)
plot(cooks.distance(m0), type = "h", col = "grey40",
xlab = "osservazione", ylab = "distanza di Cook",
main = "distanza di Cook (kidiq, m1)")
par(mfrow = c(1, 1))
