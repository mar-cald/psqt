#| label: relative-likelihood
A <- AIC(m0, m1, m2, m3, m4)
A$delta <- max(A$AIC) - A$AIC
A$rl    <- exp(A$delta / 2)
#| label: akaike-weights
A$w <- A$rl / sum(A$rl)
#| label: pairwise
ER <- outer(A$rl, A$rl, "/")
rownames(ER) <- colnames(ER) <- rownames(A)
round(log(ER), 1)
#| label: pairwise-plot
#| fig-height: 4.5
#| fig-width: 6
#| code-fold: true
#| code-summary: "Codice del grafico"
logER <- log(ER)
n <- nrow(logER)
par(mar = c(4, 4, 3, 1))
image(1:n, 1:n, t(logER[n:1, ]), col = hcl.colors(25, "Magenta"),
axes = FALSE, xlab = "", ylab = "",
main = "log evidenza relativa (riga vs colonna)")
axis(1, at = 1:n, labels = colnames(logER))
axis(2, at = 1:n, labels = rev(rownames(logER)), las = 1)
for (i in 1:n) for (j in 1:n)
par(mar = c(4, 4, 3, 1))
image(1:n, 1:n, t(logER[n:1, ]), col = hcl.colors(25, "Magenta"),
axes = FALSE, xlab = "", ylab = "",
main = "log evidenza relativa (riga vs colonna)")
axis(1, at = 1:n, labels = colnames(logER))
axis(2, at = 1:n, labels = rev(rownames(logER)), las = 1)
for (i in 1:n) for (j in 1:n)
text(substitute(paste(bold(as.character(j)))), n + 1 - i, round(logER[i, j], 1), cex = 1.2,col = "white")
logER <- log(ER)
