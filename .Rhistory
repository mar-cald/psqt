col = "black", xlab = expression(theta), ylab = "densita di probabilita")
abline(v = 0.2222222, color = "blue")
}
z <- c(2, 20, 200)          # maschi osservati
N <- c(9, 90, 900)          # animali osservati
par(mfrow = c(1, 3), mar = c(4, 4, 3, 1))
for (i in 1:3) {
curve(dbeta(x, 10 + z[i], 10 + N[i] - z[i]), from = 0, to = 1, lwd = 2,
col = "red", xlab = expression(theta), ylab = "densita di probabilita",
main = paste0(z[i], " maschi su ", N[i]))
curve(dbeta(x, 10, 10), from = 0, to = 1, lwd = 2,lty = 2, add = TRUE,
col = "black", xlab = expression(theta), ylab = "densita di probabilita")
abline(v = 0.2222222, color = "blue")
}
z <- c(2, 20, 200)          # maschi osservati
N <- c(9, 90, 900)          # animali osservati
par(mfrow = c(1, 3), mar = c(4, 4, 3, 1))
for (i in 1:3) {
curve(dbeta(x, 20 + z[i], 20 + N[i] - z[i]), from = 0, to = 1, lwd = 2,
col = "red", xlab = expression(theta), ylab = "densita di probabilita",
main = paste0(z[i], " maschi su ", N[i]))
curve(dbeta(x, 20, 20), from = 0, to = 1, lwd = 2,lty = 2, add = TRUE,
col = "black", xlab = expression(theta), ylab = "densita di probabilita")
abline(v = 0.2222222, color = "blue")
}
