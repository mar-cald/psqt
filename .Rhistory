#| label: rinforzo-loo
library(loo)
#| label: griglia-2d
#| code-fold: true
mu_griglia    <- seq(65, 105, length.out = 200)
sigma_griglia <- seq(5, 50, length.out = 200)
POST <- matrix(NA, nrow = 200, ncol = 200)   # righe: mu; colonne: sigma
for (i in 1:200) {
for (j in 1:200) {
prior_ij  <- dnorm(mu_griglia[i], 100, 10) * dunif(sigma_griglia[j], 0, 50)
like_ij   <- prod(dnorm(y, mu_griglia[i], sigma_griglia[j]))
POST[i, j] <- prior_ij * like_ij
}
}
POST <- POST / sum(POST)                     # normalizzo
contour(mu_griglia, sigma_griglia, POST,
xlab = expression(mu), ylab = expression(sigma), drawlabels = FALSE)
#| label: griglia-2d-marginali
#| fig-height: 3.8
#| fig-width: 8
#| code-fold: true
post_mu    <- rowSums(POST)      # marginalizzo su sigma
post_sigma <- colSums(POST)      # marginalizzo su mu
par(mfrow = c(1, 2), mar = c(4, 4, 3, 1))
plot(mu_griglia, post_mu, type = "l", lwd = 2,
xlab = expression(mu), ylab = expression(p(mu~"|"~D)))
plot(sigma_griglia, post_sigma, type = "l", lwd = 2,
xlab = expression(sigma), ylab = expression(p(sigma~"|"~D)))
#| label: griglia-2d
#| code-fold: true
