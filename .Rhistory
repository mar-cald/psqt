#| label: normale-griglia-verifica
mu_griglia <- seq(70, 110, by = 0.1)
prior <- dnorm(mu_griglia, 100, 10)
like  <- numeric(length(mu_griglia))
#| label: qi-dati
y <- c(73, 101, 74, 76, 112, 71, 71, 75, 97, 67)
#| label: normale-mano
mu0  <- 100; tau0 <- 10        # prior
sigma <- 15                    # ds nota
n <- length(y); ybar <- mean(y)
prec_prior <- 1 / tau0^2       # precisione della prior
prec_dati  <- n / sigma^2      # precisione dei dati
mu1  <- (prec_prior * mu0 + prec_dati * ybar) / (prec_prior + prec_dati)
tau1 <- sqrt(1 / (prec_prior + prec_dati))
c(media_post = mu1, ds_post = tau1)
#| label: normale-griglia-verifica
