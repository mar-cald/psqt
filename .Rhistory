#| label: kiwi-griglia
theta <- c(0.25, 0.50, 0.75)          # valori possibili del parametro
prior <- c(0.25, 0.50, 0.25)          # probabilita a priori
# dati: 2 maschi su 9 animali
z <- 2; N <- 9
like <- theta^z * (1 - theta)^(N - z) # verosimiglianza di ciascun theta
pD <- sum(like * prior)               # evidence: p(D)
post <- (like * prior) / pD             # teorema di Bayes
round(data.frame(theta, prior, like, post), 4)
#| label: kiwi-plot
#| fig-height: 3.4
#| fig-width: 9
#| code-fold: true
#| code-summary: "Codice del grafico"
par(mfrow = c(1, 3), mar = c(4, 4, 3, 1))
plot(theta, prior, type = "h", lwd = 4, xlim = c(0, 1), ylim = c(0, 1),
xlab = expression(theta), ylab = expression(p(theta)), main = "Prior")
plot(theta, like, type = "h", lwd = 4, xlim = c(0, 1),
xlab = expression(theta), ylab = expression(p(D~"|"~theta)),
main = "Likelihood")
plot(theta, post, type = "h", lwd = 4, xlim = c(0, 1), ylim = c(0, 1),
xlab = expression(theta), ylab = expression(p(theta~"|"~D)),
main = "Posterior")
