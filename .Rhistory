for (i in 1:200) {
for (j in 1:200) {
prior_ij  <- dnorm(mu_griglia[i], 100, 10) * dunif(sigma_griglia[j], 0, 40)
like_ij   <- prod(dnorm(y, mu_griglia[i], sigma_griglia[j]))
POST[i, j] <- prior_ij * like_ij
}
}
POST <- POST / sum(POST)                     # normalizzo
contour(mu_griglia, sigma_griglia, POST,
xlab = expression(mu), ylab = expression(sigma), drawlabels = FALSE)
