set.seed(1)
controllo   <- as.vector(mvrnorm(30, mu = 80.8, Sigma = 10.05^2, empirical = TRUE))
trattamento <- as.vector(mvrnorm(30, mu = 75.6, Sigma = 14.76^2, empirical = TRUE))
#| label: meditazione-dati
library(MASS)
set.seed(1)
controllo   <- as.vector(mvrnorm(30, mu = 80.8, Sigma = 10.05^2, empirical = TRUE))
trattamento <- as.vector(mvrnorm(30, mu = 75.6, Sigma = 14.76^2, empirical = TRUE))
meditazione <- data.frame(gruppo = rep(c("controllo", "trattamento"), each = 30),
stress = c(controllo, trattamento))
mean(controllo)
mean(trattamento)
set.seed(1)
controllo   <- as.vector(mvrnorm(30, mu = 80.8, Sigma = 10.05^2, empirical = FALSE))
trattamento <- as.vector(mvrnorm(30, mu = 75.6, Sigma = 14.76^2, empirical = FALSE))
set.seed(1)
mean(controllo)
mean(trattamento)
mean(trattamento)-mean(controllo)
set.seed(1515)
controllo   <- as.vector(mvrnorm(30, mu = 80.8, Sigma = 10.05^2, empirical = FALSE))
trattamento <- as.vector(mvrnorm(30, mu = 75.6, Sigma = 14.76^2, empirical = FALSE))
mean(trattamento)-mean(controllo)
meditazione$stress[meditazione$gruppo=="trattamento"]
mean(meditazione$stress[meditazione$gruppo=="trattamento"])-mean(meditazione$stress[meditazione$gruppo=="controllo"])
